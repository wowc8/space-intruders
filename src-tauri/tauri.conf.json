{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Space Intruders",
  "version": "0.1.0",
  "identifier": "com.spaceintruders.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Space Intruders",
      "width": 1000,
      "height": 840,
      "minWidth": 640,
      "minHeight": 600,
      "backgroundColor": "#090d1a"
    }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "macOS": { "minimumSystemVersion": "13.0" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"]
  }
}
